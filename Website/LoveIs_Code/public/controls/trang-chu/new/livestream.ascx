<%@ Control Language="C#" AutoEventWireup="true" CodeFile="livestream.ascx.cs" Inherits="public_controls_trang_chu_new_livestream" %>
<section class="livestream-section">
    <div class="container">
        <div class="livestream-grid">
            <div class="livestream-card">
                <div class="livestream-card-header">
                    <div class="livestream-card-title">VIDEO REVIEW</div>
                    <a class="livestream-card-link" href="#">See all</a>
                </div>
                <div class="livestream-card-body">
                    <a class="livestream-tile" href="#">
                        <img src="/images/livestream/1.jpg" alt="Video review 1" />
                        <span class="livestream-pill">Video</span>
                    </a>
                    <a class="livestream-tile" href="#">
                        <img src="/images/livestream/2.jpg" alt="Video review 2" />
                        <span class="livestream-pill">Video</span>
                    </a>
                </div>
            </div>

            <div class="livestream-card">
                <div class="livestream-card-header">
                    <div class="livestream-card-title">LIVESTREAM</div>
                    <a class="livestream-card-link" href="#">See all</a>
                </div>
                <div class="livestream-card-body">
                    <a class="livestream-tile" href="#">
                        <img src="/images/livestream/3.jpg" alt="Livestream 1" />
                        <span class="livestream-badge">LIVESTREAM</span>
                        <span class="livestream-meta">1.15 THURSDAY 7:00<br />DISTRICT 2, HCMC</span>
                    </a>
                    <a class="livestream-tile" href="#">
                        <img src="/images/livestream/4.jpg" alt="Livestream 2" />
                        <span class="livestream-badge">LIVESTREAM</span>
                        <span class="livestream-meta">1.15 THURSDAY 7:00<br />DISTRICT 2, HCMC</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
